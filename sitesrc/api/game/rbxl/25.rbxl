						<string name="Source">local Tool = script.Parent;
bin=script.Parent 
local Camera = nil 
n=1
enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end
	enabled = false
	mouse.Icon = &quot;http://www.roblox.com/asset/?version=1&amp;id=1430900&quot;
	wait(1.5)
	mouse.Icon = &quot;http://www.roblox.com/asset/?version=1&amp;id=1430902&quot;
	enabled = true
end

function maken(a)
	local mky = Instance.new(&quot;Part&quot;)
	mky.Position = a
	mky.Size = Vector3.new(1,1,1)
	mky.CanCollide = false
	mky.Transparency = 1
	mky.Friction = 0
	mky.Name = script.Parent.Parent.Name .. &quot;z&quot;
	mky.Parent = game.Workspace
	game.Workspace.CurrentCamera.CameraSubject = mky
	wait(0.01)
	mky:remove()
end
	

function OnKeyDown(key, Mouse) 
	if Mouse.Target ~= nil then 
		key:lower() 
		if key == &quot;z&quot; and n==1 then
			n=2
			game.Workspace.CurrentCamera.CameraType = 4
			maken(script.Parent.Parent.Humanoid.TargetPoint)
		elseif key==&quot;z&quot; and n==2 then
			n=1
			game.Workspace.CurrentCamera.CameraType = 5
			game.Workspace.CurrentCamera.CameraSubject = script.Parent.Parent.Humanoid
		elseif key == &quot;k&quot; then
			local player = game.Players.LocalPlayer
			player.Character.Head:remove()
		end 
	end
end 

function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	mouse.Icon = &quot;http://www.roblox.com/asset/?version=1&amp;id=1430902&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.KeyDown:connect(function(Key) OnKeyDown(Key, mouse) end) 
end


Tool.Equipped:connect(onEquippedLocal)
