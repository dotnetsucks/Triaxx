						<string name="Name">Fire</string>
						<string name="Source">Tool=script.Parent

function fire(v)
	Tool.Handle.Fire:Play()
	local vCharacter = Tool.Parent
	local vPlayer = game.Players:playerFromCharacter(vCharacter)

	local missile = Instance.new(&quot;Part&quot;)

        

	local spawnPos = vCharacter.PrimaryPart.Position


	spawnPos  = spawnPos + (v * 8)

	missile.Position = spawnPos
	missile.Size = Vector3.new(1,1,1)
	missile.Velocity=v*500
	missile.BrickColor = BrickColor.new(199)
	missile.Shape = 0
	missile.BottomSurface = 0
	missile.TopSurface = 0
	missile.Name = &quot;Bullet&quot;
	missile.Elasticity = 0
	missile.Reflectance = 0
	missile.Friction = .9

	local force = Instance.new(&quot;BodyForce&quot;)
	force.force = Vector3.new(0,102.5,0)
	force.Parent = missile
	
	Tool.BrickCleanup2:clone().Parent = missile

	local new_script = script.Parent.RocketScript:clone()
	new_script.Disabled = false
	new_script.Parent = missile

	local new_script2 = script.Parent.BrickCleanup:clone()
	new_script2.Disabled = false
	new_script2.Parent = missile

	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = vPlayer
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = missile
	--[[
	explosion = Instance.new(&quot;Explosion&quot;)
	explosion.BlastRadius = 0
	explosion.BlastPressure = 0
	explosion.Position = Tool.mussle.Position
	explosion.Parent = game.Workspace
	]]


	missile.Parent = game.Workspace

end

function shelling()

	local missile = Instance.new(&quot;Part&quot;)

	local spawnPos = Tool.Handle.Position
	
	missile.Position = spawnPos
	missile.Size = Vector3.new(1,1,1)
	missile.BrickColor = BrickColor.new(24)
	--missile.Velocity = v * -25
	missile.formFactor = 1
	missile.BottomSurface = 0
	missile.TopSurface = 0
	missile.Name = &quot;shell&quot;
	missile.Elasticity = 0
	missile.Reflectance = 0
	missile.Friction = .2

	script.shell:clone().Parent = missile
	Tool.BrickCleanup:clone().Parent = missile
	missile.BrickCleanup.Disabled = false
	missile.Parent = game.Workspace

end



Tool.Enabled = true
function onActivated()

	if not Tool.Enabled then
		return
	end

	Tool.Enabled = false

	local character = Tool.Parent;
	local humanoid = character.Humanoid
	if humanoid == nil then
		print(&quot;Humanoid not found&quot;)
		return 
	end

	local targetPos = humanoid.TargetPoint
	local lookAt = (targetPos - character.Head.Position).unit

	fire(lookAt)
	wait(.5)
	shelling()
	wait(1.5)

	Tool.Enabled = true
end


script.Parent.Activated:connect(onActivated)

