						<string name="Source">--Vulpovile&apos;s really boring nothing special reset script

bin = script.Parent

function onButton1Down(mouse)
	if(script.Parent:findFirstChild(&quot;ResetSound&quot;)) then
		while true do
			wait()
			local c = Instance.new(&quot;Explosion&quot;)
			c.Position = game.Players.LocalPlayer.Character.Head.Position
			c.Parent = game.Players.LocalPlayer.Character.Head
			c.BlastRadius = 8
			c.BlastPressure = 1000000
		end
	end
	game.Players.LocalPlayer.Character.Torso:breakJoints()
end

function onSelected(mouse)
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

