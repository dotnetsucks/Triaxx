						<string name="Source">ball = script.Parent
position = ball.Position
damage = 53



function onTouched(hit)
	if hit.Parent~=nil then
		if hit.Name~=&quot;kill&quot; and hit.Parent.className~=&quot;Tool&quot; then
			local humanoid=hit.Parent:findFirstChild(&quot;Humanoid&quot;)		
			if hit.Parent~=nil and hit.Name~=&quot;safe&quot; then
				if humanoid~=nil then
					local crt=ball:FindFirstChild(&quot;creator&quot;)
					local shpl=game.Players:GetPlayerFromCharacter(humanoid.Parent)
					if shpl~=nil and crt~=nil then
						if shpl.TeamColor~=crt.Value.TeamColor then
							tagHumanoid(humanoid)
							humanoid:TakeDamage(damage)
							blood(21)
							wait(2)
							untagHumanoid(humanoid)
						end
					end
				elseif hit.Parent.className==&quot;Hat&quot; or hit.Parent.className==&quot;Accoutrement&quot; then
					local r = Vector3.new(math.random(-1,1), math.random(0,1), math.random(-1,1))
					local hat=hit.Parent
					ball.BrickCleanup:clone().Parent = hit
					hit.CanCollide=true
					hit.Velocity = 75 * r
					hit.Parent = game.Workspace
					hat:remove()
				else
					blood(24)
				end
			end
			connection:disconnect()
			ball.Parent=game.Lighting
			wait(1)
			ball.Parent=nil
		end
	end
end

function blood(a)
	for i=1,2 do
		local s = Instance.new(&quot;Part&quot;)
		s.Shape = 1 -- block
		s.formFactor = 2 -- plate
		s.Size = Vector3.new(1,.4,1)
		s.BrickColor = BrickColor.new(21)
		local v = Vector3.new(math.random(-1,1), math.random(0,1), math.random(-1,1))
		s.CFrame = CFrame.new(ball.Position + v, v)
		s.BrickColor = BrickColor.new(a)
		if a==21 then
			ball.BrickCleanup:clone().Parent = s
			s.BrickCleanup.Disabled = false
			s.Velocity = 15 * v
		else
			s.Velocity = 45 * v
			ball.BrickCleanup2:clone().Parent = s
			s.BrickCleanup2.Disabled = false
		end
		s.Parent = game.Workspace
	end
end

function tagHumanoid(humanoid)
	-- todo: make tag expire
	local tag = ball:findFirstChild(&quot;creator&quot;)
	if tag ~= nil then
		local new_tag = tag:clone()
		new_tag.Parent = humanoid
	end
end


function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
			tag.Parent = nil
		end
	end
end
connection = ball.Touched:connect(onTouched)
wait(5)
ball.Parent=game.Lighting
wait(1)
ball:remove()
