			<Item class="Script" referent="RBX12">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">local value = game.Workspace:FindFirstChild(&quot;startValue&quot;)
local spwn = script.Parent
local value2 = game.Workspace:FindFirstChild(&quot;levelValue&quot;)
local decrease = 0.5
local damage = 100

local function doom()
local cube = Instance.new(&quot;Part&quot;)
local face = Instance.new(&quot;Decal&quot;)
face.Texture = &quot;rbxasset://Textures/face.png&quot;
cube.Name = &quot;Doom cube&quot;
cube.Size = Vector3.new(10, 10, 10)
cube.BrickColor = BrickColor.new(math.random(1, 226))
cube.Position = spwn.Position + Vector3.new(0, 10 ,0)
face.Face = &quot;Back&quot;
face.Parent = cube
cube.Parent = game.Workspace
cube.Velocity = Vector3.new(0, 15, 350)

coroutine.wrap(function()
wait(30)
if cube and cube.Parent then
cube.Parent = nil
end
end)()

cube.Touched:connect(function(hit)
local humanoid = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if humanoid then
hit:BreakJoints()
end
end)
end

spwn.Touched:connect(function(hit)
value2.Value = value2.Value - decrease
local humanoid = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if humanoid then
local sound = Instance.new(&quot;Sound&quot;)
sound.SoundId = &quot;rbxasset://sounds/Launching rocket.wav&quot;
sound.Parent = hit.Parent.Head
hit.Parent:MoveTo(Vector3.new(0, 100, 65))
sound:Play()
wait(3)
sound.Parent = nil
end
end)

while true do

wait(0.01)
if value.Value == true then
doom()
wait(value2.Value)
end
end
</string>
