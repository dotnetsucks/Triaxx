		<Item class="HopperBin" referent="RBX1702">
			<Properties>
				<token name="BinType">0</token>
				<string name="Name">ClassicFlamethrower</string>
				<Content name="TextureId"><url>rbxasset://Textures/Flamethrower.png</url></Content>
