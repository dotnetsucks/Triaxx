shooting = false
reloadtime = 0

local colors = {21, 106, 105, 24, 226, 1, 226, 24, 105, 106} 

function fire(v)

	sound = Instance.new(&quot;Sound&quot;)
	sound.SoundId = &quot;rbxasset://sounds\\Launching rocket.wav&quot;
	sound.Parent = script.Parent
	sound:play()

	local missile = Instance.new(&quot;Part&quot;)

	local spawnPos = game.Players.LocalPlayer.Character.PrimaryPart.Position
	spawnPos = spawnPos + (v * 7)

	missile.Name = &quot;Cannon Shot&quot;

	local dx = (math.random() - .5) * 100
	local dy = (math.random() - .5) * 100
	local dz = (math.random() - .5) * 100

	missile.CFrame = CFrame.new(spawnPos, Vector3.new(dx,dy,dz))
	missile.Size = Vector3.new(1,1,1)
	missile.Velocity = v * 150
	missile.BrickColor = BrickColor.new(colors[math.random(1, 10)])
	missile.Shape = 2

	local new_script = script.Parent.FireShot:clone()
	new_script.Disabled = false
	new_script.Parent = missile

	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = game.Players.LocalPlayer
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = missile
	
	missile.Parent = game.Workspace
	sound:remove()
end


function onButton1Down(mouse)
	if reloadtime &gt; 0 then return end
	if shooting == true then return end
	print(&quot;start shooting&quot;)
	reloadtime = 4.0
	shooting = true

	local time = 0
	while shooting == true do

		local cf = mouse.Hit
		local v = cf.lookVector
		local dx = (math.random() - .5) * .2
		local dy = (math.random() - .5) * .2
		local dz = (math.random() - .5) * .2

		fire(Vector3.new(v.x + dx, v.y + dy, v.z + dz))
		wait(.05)
		time = time + .05
		if time &gt; 2.0 then shooting = false end
	end
	print(&quot;stop shooting&quot;)
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
	while reloadtime &gt; 0 do
		wait(0.1)
		reloadtime = reloadtime - 0.1
	end
	reloadtime = 0
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end

function onButton1Up(mouse)
	shooting = false
end

function onSelected(mouse)
	print(&quot;flamethrower selected&quot;)
	if reloadtime &gt; 0 then
		mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
		while reloadtime &gt; 0 do
			wait(0.1)
			reloadtime = reloadtime - 0.1
		end
		mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	else
		mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	end
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
end

bin.Selected:connect(onSelected)




