						<string name="Source">local isOn = true

function on()
	isOn = true
	script.Parent.Pos1.CanCollide = true
	script.Parent.Pos1.Transparency = 0
	script.Parent.Pos2.CanCollide = false
	script.Parent.Pos2.Transparency = 1
end

function off()
	isOn = false
	script.Parent.Pos1.CanCollide = false
	script.Parent.Pos1.Transparency = 1
	script.Parent.Pos2.CanCollide = true
	script.Parent.Pos2.Transparency = 0
end

function onClicked()
	
	if isOn == true then off() else on() end

end

script.Parent.Pos1.ClickDetector.MouseClick:connect(onClicked)
script.Parent.Pos2.ClickDetector.MouseClick:connect(onClicked)

on()</string>
