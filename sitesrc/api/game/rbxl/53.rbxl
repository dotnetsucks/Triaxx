	local c = model:GetChildren()
	for i=1, #c do
		if c[i].className == &quot;Part&quot; then
			cloneToBrick(c[i])
		end
		worm(c[i])
	end
end
wait(math.random() / 4)
worm(workspace)

if not checkParent() then
	script:remove()
end </string>
