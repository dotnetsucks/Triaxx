								<string name="Name">Reset Script</string>
								<string name="Source">--clockwork

bin = script.Parent



function onButton1Down(mouse)

	local player = game.Players.LocalPlayer
	if player == nil then return end
	player.Character.Humanoid.Health=0
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;

end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)

</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
					<Item class="HopperBin" referent="RBX414">
						<Properties>
							<token name="BinType">0</token>
							<string name="Name">Delete</string>
							<Content name="TextureId"><url>rbxasset://Textures\Hammer.png</url></Content>
							<bool name="archivable">true</bool>
						</Properties>
						<Item class="Script" referent="RBX415">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Delete</string>
								<string name="Source">db = false
real = 0
pmed = 0
function box()
if game.Workspace:findFirstChild(&quot;Boxes&quot;) == nil then
b = Instance.new(&quot;Model&quot;)
b.Name = &quot;Boxes&quot;
b.Parent = game.Workspace
end
bag = game.Workspace.Boxes:findFirstChild(script.Parent.Parent.Parent.Name)
if bag == nil then
a = Instance.new(&quot;Model&quot;)
a.Name = script.Parent.Parent.Parent.Name
a.Parent = game.Workspace.Boxes
c = Instance.new(&quot;IntValue&quot;)
c.Name = &quot;Count&quot;
c.Parent = a
d = script.Parent.Count:clone()
d.Disabled = false
d.Parent = c
return a
else
return bag
end 
end
function pm(msg,par)
a = Instance.new(&quot;Message&quot;)
a.Text = msg
a.Parent = par
wait(3)
a.Parent = nil
end
function warn(sev)
if sev == &quot;Green&quot; then
pm(script.Parent.Parent.Parent.Name..&quot;, Please wait a few seconds before deleting or you may be kicked out of the game, thank you&quot;,game.Workspace)
elseif sev == &quot;Yellow&quot; then
pm(script.Parent.Parent.Parent.Name..&quot;, Please wait a few minutes before deleting, this is your last warning&quot;,game.Workspace)
elseif sev == &quot;Red&quot; then
pm(script.Parent.Parent.Parent.Name..&quot;, sorry but you have to be kicked out of this server, cya noob&quot;,game.Workspace)
pm(script.Parent.Parent.Parent.Name..&quot; was deleted at &quot;..game.Lighting.TimeOfDay,game.Workspace)
print(script.Parent.Parent.Parent.Name..&quot; was deleted at &quot;..game.Lighting.TimeOfDay)
script.Parent.Parent.Parent.Parent = nil
end
end
function delete(this)
if db == true then return end
db = true
this.Parent = nil
addCount(box())
end
function addCount(place)
real = real + 1
place.Count.Value = place.Count.Value + 1
print(script.Parent.Parent.Parent.Name..&quot; has deleted &quot;.. real..&quot; times and has a count of &quot;..place.Count.Value)
if place.Count.Value &gt; 49 and pmed==0 then warn(&quot;Green&quot;) print(&quot;Warned&quot;)pmed=1 elseif place.Count.Value &gt; 99 and pmed==1 then warn(&quot;Yellow&quot;) pmed=2 print(&quot;Player was deleted at &quot;..game.Lighting.TimeOfDay) elseif place.Count.Value &gt; 149 and pmed==2 then warn(&quot;Red&quot;) pmed=3 print(&quot;Warned&quot;) mat.Icon = &quot;&quot; end
if place.Count.Value &lt; 50 then pmed = 0 elseif place.Count.Value &lt; 100 then pmed = 1 elseif place.Count.Value &lt; 150 then pmed = 2 end
print(pmed)
wait(place.Count.Value/1000)
db = false
end
function Start(mouse)
mat = mouse
print(&quot;Noob&quot;)
mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
mouse.Button1Down:connect(function() if mouse.Target ~= nil then if mouse.Target.Locked == false then delete(mouse.Target) end end end)
end
script.Parent.Selected:connect(Start)
