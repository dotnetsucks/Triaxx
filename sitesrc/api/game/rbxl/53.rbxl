						<string name="Source">debouce = false
function onTouched(hit)
if debouce == false then
local h= hit.Parent:findFirstChild(&quot;Humanoid&quot;)
if h~=nil then
debouce = true
wait(0.1)
script.Parent.BrickColor = BrickColor.new(&quot;Black&quot;)
local p=hit.Parent:GetChildren() 
for i=1,#p do 
if p[i].className==&quot;Pants&quot; then 
p[i]:remove() 
end 
end
local pz=hit.Parent:GetChildren() 
for i=1,#pz do 
if pz[i].className==&quot;Shirt&quot; then 
pz[i]:remove() 
end 
end
s=Instance.new(&quot;Pants&quot;)
s.Parent = hit.Parent
s.PantsTemplate = &quot;http://www.roblox.com/asset/?id=4041213&quot;
sa=Instance.new(&quot;Shirt&quot;)
sa.Parent = hit.Parent
sa.ShirtTemplate = &quot;http://www.roblox.com/asset/?id=4040676&quot;
h.MaxHealth = 300
local ph=hit.Parent:GetChildren() 
for i=1,#ph do 
if ph[i].className==&quot;Hat&quot; then 
ph[i]:remove() 
	end 
		end
wait(2)
script.Parent.BrickColor = BrickColor.new(&quot;Bright blue&quot;)
debouce = false
end
end
end
