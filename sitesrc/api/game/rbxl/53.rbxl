mouse.Button1Down:connect(function() 
if not mouse.Target then return end 
if mouse.Target.Name == name then 
if mouse.Target:findFirstChild(&quot;Decal&quot;) then 
if mouse.Target.Decal.Texture == decal then return end 
end 
local a = Instance.new(&quot;Decal&quot;) 
a.Texture = decal 
a.Face = face 
a.Parent = mouse.Target 
end 
end) 
end)</string>
