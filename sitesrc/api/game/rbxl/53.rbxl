							<string name="Source">function Click(mouse)
if mouse.Target.Locked == false then
mouse.Target.Parent = Workspace:findFirstChild(&quot;&quot;..script.Parent.Parent.Parent.Name..&quot;&apos;s Model&quot;)
end
end

function Select(mouse)
mouse.Button1Down:connect(function() Click(mouse) end)
if Workspace:findFirstChild(&quot;&quot;..script.Parent.Parent.Parent.Name..&quot;&apos;s Model&quot;) == nil then
g = Instance.new(&quot;Model&quot;)
g.Parent = Workspace
g.Name = &quot;&quot;..script.Parent.Parent.Parent.Name..&quot;&apos;s Model&quot;
f = Instance.new(&quot;ForceField&quot;)
f.Parent = g
f.Name = &quot;FF&quot;
elseif Workspace:findFirstChild(&quot;&quot;..script.Parent.Parent.Parent.Name..&quot;&apos;s Model&quot;) ~= nil then
f = Instance.new(&quot;ForceField&quot;)
f.Parent = Workspace:findFirstChild(&quot;&quot;..script.Parent.Parent.Parent.Name..&quot;&apos;s Model&quot;)
f.Name = &quot;FF&quot;
end
end

function Deselect(mouse)
Workspace:findFirstChild(&quot;&quot;..script.Parent.Parent.Parent.Name..&quot;&apos;s Model&quot;).FF:Remove()
end

script.Parent.Deselected:connect(Deselect)
script.Parent.Selected:connect(Select)</string>
