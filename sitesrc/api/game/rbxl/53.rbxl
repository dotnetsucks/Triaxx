					<string name="Source">print(&quot;IronInforcer message loaded.&quot;)-- Please keep this.

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if (human ~= nil) and debounce == false then

                debounce = true

local message = Instance.new(&quot;Message&quot;)--Change this to a Hint if you want a hint.
message.Text = &quot;This cafe does not support or premote...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(4)



message:Remove ()

local message = Instance.new(&quot;Message&quot;)--Change this to a Hint if you want a hint.
message.Text = &quot;...Online dating, Please dont do it here.&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(4)



message:Remove ()

local message = Instance.new(&quot;Message&quot;)--Change this to a Hint if you want a hint.
message.Text = &quot;So we can keep The Iron Cafe&apos;...&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(4)



message:Remove ()

local message = Instance.new(&quot;Message&quot;)--Change this to a Hint if you want a hint.
message.Text = &quot;... Up and running.&quot;
message.Parent = game.Players:playerFromCharacter(hit.Parent)
wait(4)



message:Remove ()

                debounce = false
	end
end

