							<string name="Name">help</string>
							<string name="Source">--~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ LegoEditer ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~--

bin = script.Parent
reset = bin:Clone()

function onKeyDown(key)
	local player = game.Players.LocalPlayer
	if (key~=nil) then
		key = key:lower()
		if (key == &quot;y&quot;) then
		local m = Instance.new(&quot;Message&quot;)
		m.Parent = player
		m.Text = &quot;Ok, all you need to do is&quot;
		wait(6)
                m:Remove()
                local m = Instance.new(&quot;Message&quot;)
		m.Parent = player
		m.Text = &quot;Say any of the keywords&quot;
                wait(6)
                m:Remove()
                local m = Instance.new(&quot;Message&quot;)
		m.Parent = player
		m.Text = &quot;Like &apos;ketchup&apos; to get KetchUp&quot;
                wait(6)
                m:Remove()
                local m = Instance.new(&quot;Message&quot;)
		m.Parent = player
		m.Text = &quot;The ingredients are on the&quot;
		wait(5)
                m:Remove()
                local m = Instance.new(&quot;Message&quot;)
		m.Parent = player
		m.Text = &quot;side of the grill. Once you got&quot;
                wait(6)
                m:Remove()
                local m = Instance.new(&quot;Message&quot;)
		m.Parent = player
		m.Text = &quot;the tool, click in the middle of the box&quot;
                wait(5)
		m:Remove()
		local m = Instance.new(&quot;Message&quot;)
		m.Parent = player
		m.Text = &quot;before you do anything say...&quot;
                wait(5)
		m:Remove()
                local m = Instance.new(&quot;Message&quot;)
		m.Parent = player
		m.Text = &quot; &apos;box&apos; to get an Box, once your&quot;
                wait(6)
		m:Remove()
                local m = Instance.new(&quot;Message&quot;)
		m.Parent = player
		m.Text = &quot;finished use the Grab tool to give the&quot;
                wait(6)
		m:Remove()
                local m = Instance.new(&quot;Message&quot;)
		m.Parent = player
		m.Text = &quot;custumer there food. Enjoy.&quot;
                wait(6)
                m:Remove()
		m:Remove()
		end
                if (key == &quot;n&quot;) then
		local m = Instance.new(&quot;Message&quot;)
		m.Parent = player
		m.Text = &quot;Help option has been stopped.&quot;
		wait(6)
		m:Remove()
                local m = Instance.new(&quot;Message&quot;)
		m.Parent = player
		m.Text = &quot;Thank you for using Dingy2&apos;s help tool&quot;
		wait(6)
		m:Remove()
		help.Parent = player.Backpack
		bin:Remove()
		end
	end
end

function onButton1Down(mouse)
	local player = game.Players.LocalPlayer
	if player == nil then return end
	local m = Instance.new(&quot;Message&quot;)
	m.Parent = player
	m.Text = &quot;Would you like to know...&quot;
        wait(4)
        m.Text = &quot;How to make burgers?&quot;
        wait(4)
	m.Text = &quot;Press on your Keyboard Y...&quot;
 	wait(4)
        m.Text = &quot;To say Yes, or Press N&quot;
        wait(3)
        m.Text = &quot;...To say No.&quot;
        wait(3)
	m:Remove()
	mouse.KeyDown:connect(onKeyDown)
	end

function onSelected(mouse)
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)

