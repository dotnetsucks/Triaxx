								<string name="Name">TeleportScript</string>
								<string name="Source">-- This script was made by Dued1 
--Edited buy RoboSanta
--Edited by 125Hunter

manip = script.Parent.manipulate
bin = script.Parent
enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	local player = game.Players.LocalPlayer
	if player == nil then return end
		
	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;

if (mouse.Target ~= nil) and (mouse.Target.Locked == false) then
if script.Parent.Mode.Value == 1 and manip.Value == 1 and mouse.Target.Locked == false then
mouse.Target.Size = Vector3.new(mouse.Target.Size.x + 1, mouse.Target.Size.y, mouse.Target.Size.z)
elseif script.Parent.Mode.Value == 2 and manip.Value == 1 and mouse.Target.Locked == false then
mouse.Target.Size = Vector3.new(mouse.Target.Size.x, mouse.Target.Size.y+1.2, mouse.Target.Size.z)
elseif script.Parent.Mode.Value == 3 and manip.Value == 1 and mouse.Target.Locked == false then
mouse.Target.Size = Vector3.new(mouse.Target.Size.x, mouse.Target.Size.y, mouse.Target.Size.z+1)
elseif script.Parent.Mode.Value == 1 and manip.Value == 2 and mouse.Target.Locked == false then
mouse.Target.Size = Vector3.new(mouse.Target.Size.x - 1, mouse.Target.Size.y, mouse.Target.Size.z)
elseif script.Parent.Mode.Value == 2 and manip.Value == 2 and mouse.Target.Locked == false then
mouse.Target.Size = Vector3.new(mouse.Target.Size.x, mouse.Target.Size.y-1.2, mouse.Target.Size.z)
elseif script.Parent.Mode.Value == 3 and manip.Value == 2 and mouse.Target.Locked == false then
mouse.Target.Size = Vector3.new(mouse.Target.Size.x, mouse.Target.Size.y, mouse.Target.Size.z-1)
end
end
		wait(0.01337)
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	enabled = true

end

function onSelected(mouse)
	 b = Instance.new(&quot;Message&quot;)
               b.Parent = script.Parent.Parent.Parent
               b.Text = &quot;Resize Tool&quot;
     
        h = Instance.new(&quot;Hint&quot;)
               h.Parent = script.Parent.Parent.Parent
               h.Text = &quot;X,Y,Z= Chose Vertex to change. T=Increase G=Decrease&quot; 
               h.Name = &quot;Hint&quot;
        mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
        mouse.KeyDown:connect(onKeyDown) 
end

function onKeyDown(key) 
if (key~=nil) then 

local key = key:lower() 


if (key==&quot;t&quot;) then 
manip.Value = 1
b.Text = &quot;Increase Brick Size&quot;
end
if (key==&quot;g&quot;) then 
manip.Value = 2
b.Text = &quot;Decrease Brick Size&quot;
end


if (key==&quot;x&quot;) then 
script.Parent.Mode.Value = 1
b.Text = &quot;Edit X value&quot;

end

if (key==&quot;y&quot;) then 
script.Parent.Mode.Value = 2
b.Text = &quot;Edit Y value&quot;
end
if (key==&quot;z&quot;) then 
script.Parent.Mode.Value = 3
b.Text = &quot;Edit Z value&quot;
end
end
end


bin.Selected:connect(onSelected)

function onDeS(mouse) 
script.Parent.Parent.Parent.Hint:remove() 
script.Parent.Parent.Parent.Message:remove() 
end 
script.Parent.Deselected:connect(onDeS)


