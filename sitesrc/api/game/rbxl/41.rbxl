						<string name="Name">Script</string>
						<string name="Source">--[[
Instructions coming soon.

Newer versions of this pet will have:
Better guard dog - does a search for anyone nearby. At the moment you need to touch to get him to chase you.
Make him your friend by feeding him
Teach him new tricks
Play games (fetch in paticular, also tag)
suggestions? send them to me!

-miked 2007
--]]



--game.Workspace.dog.RotVelocity=Vector3.new(0, 0, 60)
--=backflip
humanoid = nil
dogisattacking=0
dogawake=1
wait(10)
function onTouched(part)
	if part.Parent ~= nil then
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		if h~=nil then
				if dogisattacking==1 then
					h.Health=h.Health-(script.Parent.Aggression.Value*4)
				end
			if dogawake~=0 then
				if h==humanoid then
					return
				end
				
				local dog=script.Parent
				local owner=dog.Owner.Value
				local agg=dog.Aggression.Value
				local agi=dog.Agility.Value
				local hap=dog.Happiness.Value
				local hun=dog.Hunger.Value

				if h.Parent.Name==owner then
					--dog.RotVelocity=Vector3.new(0, 0, 60)
					--dogcelebrate()
					dogisfollowing=1
					dogawake=0
					wait(2)
					print(&quot;woof! my owner is here, i think i will follow him&quot;)
					dogfollowowner(h)
					dogisfollowing=0
					print(&quot;woof! ill stop&quot;)
					script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)
				else
					if agg&gt;4 then
						print(&quot;touched!&quot;)
						dogisfollowing=1
						dogawake=0
						wait(2)
						dogkill(h)
						dogisfollowing=0
						print(&quot;woof! ill stop attacking now&quot;)
						script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)
					else
						if hap&gt;4 then
							--dogcelebrate()
							--dog.RotVelocity=Vector3.new(0, 0, 60)
							print(&quot;touched!&quot;)
							dogisfollowing=1
							dogawake=0
							wait(2)
							dogfollowowner(h)
							dogisfollowing=0
							print(&quot;woof! ill stop&quot;)
							script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)
						end
					end
					print(&quot;bark&quot;)
					dogawake=1
					doggo()
				end
			end
		end
	end
if part.Name==&quot;toast&quot; then
script.Parent.Hunger.Value=script.Parent.Hunger.Value-1
part:remove()
end
end

script.Parent.Touched:connect(onTouched)


function dogfollowowner(h)

if h.Parent.Torso.Position~=nil then
	local goto=h.Parent.Torso.Position
	local vertdist=goto.y-script.Parent.Position.y
	if vertdist&gt;14 or vertdist&lt;-10 then
		return
	end

	local from=script.Parent.Position
	local e=(goto.x-from.x)*(goto.x-from.x)
	local f=(goto.z-from.z)*(goto.z-from.z)
	local waittime=math.sqrt(e+f)
	if waittime&gt;40 then
		return
	end
	if waittime&gt;15 then
		script.Parent.BodyVelocity.velocity=Vector3.new(goto.x-from.x,20,goto.z-from.z)
		wait(waittime/40)
		--script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)
		dogfollowowner(h)
	else
		script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)
		wait(1)
		dogfollowowner(h)
		--dogisfollowing=0
		--dogawake=1
	end
else
	script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)
	--doggohome()
end

end


function dogcelebrate()
dogawake=0
local radom=math.random(1,2)
if radom==1 then
script.Parent.RotVelocity=Vector3.new(0, 0, script.Parent.Happiness.Value*8)
else
script.Parent.RotVelocity=Vector3.new(script.Parent.Happiness.Value*5, script.Parent.Happiness.Value*5, 0)
end
script.Parent.Happiness.Value=script.Parent.Happiness.Value+1
dogawake=1
end

function dogroam()
wait(1)
script.Parent.BodyVelocity.velocity=Vector3.new((0.8*script.Parent.Agility.Value+9)*(math.sin(math.rad(math.random(0,360)))),20,(0.8*script.Parent.Agility.Value+9)*(math.sin(math.rad(math.random(0,360)))))
wait(2)
script.Parent.BodyVelocity.velocity=Vector3.new(0,20,0)
wait(1)
script.Parent.BodyVelocity.velocity=Vector3.new((0.8*script.Parent.Agility.Value+9)*(math.sin(math.rad(math.random(0,360)))),20,(0.8*script.Parent.Agility.Value+9)*(math.sin(math.rad(math.random(0,360)))))
wait(2)
script.Parent.BodyVelocity.velocity=Vector3.new(0,20,0)
wait(1)
script.Parent.BodyVelocity.velocity=Vector3.new((0.8*script.Parent.Agility.Value+9)*(math.sin(math.rad(math.random(0,360)))),20,(0.8*script.Parent.Agility.Value+9)*(math.sin(math.rad(math.random(0,360)))))
wait(2)
script.Parent.BodyVelocity.velocity=Vector3.new(0,20,0)
wait(1)
end

function doggohome()
	local goto=script.Parent.Parent.DogHouse.DogBowl.Position
	local vertdist=goto.y-script.Parent.Position.y
	local from=script.Parent.Position

	local e=(goto.x-from.x)*(goto.x-from.x)
	local f=(goto.z-from.z)*(goto.z-from.z)
	local distance=math.sqrt(e+f)

if distance&lt;14 then
return
end
	--get a good ratio.
local xa=goto.x-from.x
local za=goto.z-from.z
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
	script.Parent.BodyVelocity.velocity=Vector3.new(xa,20,za)

wait((math.sqrt(xa*xa+za*za))/40)
doggohome()
end

function dogfindfood()
	local goto=script.Parent.Parent.DogHouse.DogBowl.Position
	local vertdist=goto.y-script.Parent.Position.y
	if vertdist&gt;14 or vertdist&lt;-10 then
		print(&quot;My food is miles away! im starving!&quot;)
		return
	end
	local from=script.Parent.Position

	local e=(goto.x-from.x)*(goto.x-from.x)
	local f=(goto.z-from.z)*(goto.z-from.z)
	local distance=math.sqrt(e+f)

if distance&lt;7 then
script.Parent.Hunger.Value=0
return
end
	--get a good ratio.
local xa=goto.x-from.x
local za=goto.z-from.z
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
if xa&gt;30 or za&gt;30 then
	xa=xa/1.3
	za=za/1.3
end
	script.Parent.BodyVelocity.velocity=Vector3.new(xa,20,za)

wait((math.sqrt(xa*xa+za*za))/40)
dogfindfood()
	
end

function dogkill(h)

if h.Parent.Torso.Position~=nil then
	local goto=h.Parent.Torso.Position
	local vertdist=goto.y-script.Parent.Position.y
	if vertdist&gt;14 or vertdist&lt;-10 then
		return
	end

	local from=script.Parent.Position
	local e=(goto.x-from.x)*(goto.x-from.x)
	local f=(goto.z-from.z)*(goto.z-from.z)
	local waittime=math.sqrt(e+f)
	if waittime&gt;script.Parent.Aggression.Value*10 then
		return
	end
	if waittime&gt;18 then
		script.Parent.BodyVelocity.velocity=Vector3.new(goto.x-from.x,20,goto.z-from.z)
		wait(waittime/40)
		--script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)
		dogkill(h)
	else
	--
	--leap and attack
		print(&quot;attack!&quot;)
		wait(.3)
		dogisattacking=1
		script.Parent.RotVelocity=Vector3.new(0, 0, 40)
		wait(.3)
		script.Parent.BodyVelocity.velocity=Vector3.new(6*(goto.x-from.x),130,6*(goto.z-from.z))
		wait(.7)
		script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)
		dogisattacking=0
		if h.Health&lt;1 then
			return
		end
		if h.Health==nil then
			return
		end
		dogkill(h)
		--dogisfollowing=0
		--dogawake=1
	end
else
	script.Parent.BodyVelocity.velocity=Vector3.new(0,-20,0)
	--doggohome()
end
end


function agilchange()
local agilforce=script.Parent.Agility.Value*125+2000
script.Parent.BodyVelocity.maxForce=Vector3.new(agilforce,200,agilforce)
end
script.Parent.Agility.Changed:connect(agilchange)

function hungchanged()
local hunger=script.Parent.Hunger.Value
script.Parent.Agility.Value=10 - hunger
script.Parent.Happiness.Value=8 - hunger
end
script.Parent.Hunger.Changed:connect(hungchange)



function doggo()
wait(2)
if script.Parent.Hunger.Value&gt;7 then
	dogfindfood()
else
	local ran=math.random(1,50)
	if ran&lt;5 then
		dogcelebrate()
	else
		if ran&lt;43 then
			dogroam()
		else	
			if ran&lt;48 then
				doggohome()
			end
			script.Parent.Hunger.Value=script.Parent.Hunger.Value+1
		end
	end
end
wait(1)
if dogawake==1 then
	doggo()
end
end

script.Parent.Hunger.Value=0
script.Parent.Agility.Value=8
script.Parent.Happiness.Value=8

doggo()</string>
