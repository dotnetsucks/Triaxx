			<Item class="Script" referent="RBX2208">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">local debounce = false

function getPlayer(humanoid)
	-- find the owning player of a humanoid.
	local players = game.Players:children()
	for i = 1, #players do
		if players[i].Character ~= nil then
			if players[i].Character.Humanoid == humanoid then return players[i] end
		end
	end
	return nil
end


function displayMsg(humanoid)

	local torso = humanoid.Parent.Torso


	local player = getPlayer(humanoid)
	if player ~= nil then
		local message = Instance.new(&quot;Message&quot;)
		message.Text = &quot;This is Pinkie&quot;
		message.Parent = player
		wait(3)
		message.Text = &quot;She is my best friend on roblox&quot;
		wait(3)
		message.Text = &quot;If you see her, say Hello&quot;
		wait(3)
                message.Text = &quot;And be nice to her&quot;
                wait(3)
                message.Text =&quot;&apos;&apos;Made by Dingba&apos;&quot;
                wait(3)
		message.Parent = nil
	end


end

function onTouched(hit)
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid~=nil and debounce == false then
		debounce = true
		displayMsg(humanoid)
		debounce = false
	end
end


script.Parent.Touched:connect(onTouched)

