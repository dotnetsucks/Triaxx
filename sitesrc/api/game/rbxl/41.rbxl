local head = script.Parent
local sound = head:findFirstChild(&quot;Victory&quot;)

function onTouched(part)
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
sound:play()
if part.Parent:findFirstChild(&quot;Head&quot;):findFirstChild(&quot;face&quot;).Texture == nil then return end
part.Parent:findFirstChild(&quot;Head&quot;):findFirstChild(&quot;face&quot;).Texture=&quot;http://www.roblox.com/asset/?version=1&amp;id=1095782&quot;
	end
end

