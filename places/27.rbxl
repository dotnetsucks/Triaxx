function hai(y)
a = false
	if 
		game:GetService("BadgeService"):UserHasBadge(y.userId, 14677969) == true and
		game:GetService("BadgeService"):UserHasBadge(y.userId, 14677914) == true and
		game:GetService("BadgeService"):UserHasBadge(y.userId, 14678075) == true and
		game:GetService("BadgeService"):UserHasBadge(y.userId, 14678118) == true and
		game:GetService("BadgeService"):UserHasBadge(y.userId, 14678224) == true then
		y.TeamColor = BrickColor.new(28)
		a = true
		local r = game.Players:GetChildren()
		for i = 1,#r do
			if r[i].TeamColor == BrickColor.new(28) then
				if 
					game:GetService("BadgeService"):UserHasBadge(r[i].userId, 14677969) == false or
					game:GetService("BadgeService"):UserHasBadge(r[i].userId, 14677914) == false or
					game:GetService("BadgeService"):UserHasBadge(r[i].userId, 14678075) == false or
