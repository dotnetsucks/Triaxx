          </Content>
          <string name="Name">Script</string>
          <ProtectedString name="Source">function check()
local g = game.Players:GetChildren()
for i = 1,#g do
if g[i].TeamColor == BrickColor.new(28) then
return false
end
end
return true
end



de = false
function click(hit)
	if hit.Parent:FindFirstChild("Humanoid") ~= nil and de == false then
		local g = game.Players:GetPlayerFromCharacter(hit.Parent)
		if g ~= nil and g.TeamColor == BrickColor.new(28) then
			script.Parent.CanCollide = false
			de = true
			wait(1)
			de = false
			script.Parent.CanCollide = true
		elseif check() == true then
			script.Parent.CanCollide = false
			de = true
			wait(1)
			de = false
			script.Parent.CanCollide = true
		end
	end
end

script.Parent.Touched:connect(click)</ProtectedString>
