    <Item class="Script" referent="RBX1512">
      <Properties>
        <bool name="Disabled">false</bool>
        <Content name="LinkedSource">
          <null></null>
        </Content>
        <string name="Name">Seasons</string>
        <ProtectedString name="Source">script.Season.Value = math.random(1,4)
wait()

	if script.Season.Value == 1 then -- Summer
		script.Season.Value = 2
		game.Lighting.Sky.SkyboxBk = "rbxasset://../../../shareddata/assets/2326662"
		game.Lighting.Sky.SkyboxDn = "rbxasset://../../../shareddata/assets/2326681"
		game.Lighting.Sky.SkyboxFt = "rbxasset://../../../shareddata/assets/2326652"
		game.Lighting.Sky.SkyboxLf = "rbxasset://../../../shareddata/assets/2326666"
		game.Lighting.Sky.SkyboxRt = "rbxasset://../../../shareddata/assets/2326670"
		game.Lighting.Sky.SkyboxUp = "rbxasset://../../../shareddata/assets/2326677"
		local g = game.Workspace:GetChildren()
		for i = 1,#g do
			if g[i].Name == "Tree" then
				g[i].Part.BrickColor = script.Summer.Value
			elseif g[i].Name == "Baseo" then
				g[i].BrickColor = script.Summer.Value
			end
		end



	elseif script.Season.Value == 2 then -- Fall
		script.Season.Value = 3
		game.Lighting.Sky.SkyboxBk = "rbxasset://../../../shareddata/assets/1014350"
		game.Lighting.Sky.SkyboxDn = "rbxasset://../../../shareddata/assets/1014351"
		game.Lighting.Sky.SkyboxFt = "rbxasset://../../../shareddata/assets/1014348"
		game.Lighting.Sky.SkyboxLf = "rbxasset://../../../shareddata/assets/1014349"
		game.Lighting.Sky.SkyboxRt = "rbxasset://../../../shareddata/assets/1014347"
		game.Lighting.Sky.SkyboxUp = "rbxasset://../../../shareddata/assets/2326677"
		local g = game.Workspace:GetChildren()
		for i = 1,#g do
			if g[i].Name == "Tree" then
				g[i].Part.BrickColor = script.Fall.Value
			elseif g[i].Name == "Baseo" then
				g[i].BrickColor = script.Fall.Value
				g[i].Texture.Face = "Top"
			end
		end


	elseif script.Season.Value == 3 then -- Winter
		script.Season.Value = 4
		game.Lighting.Sky.SkyboxBk = "rbxasset://../../../shareddata/assets/1013852"
		game.Lighting.Sky.SkyboxDn = "rbxasset://../../../shareddata/assets/1013853"
		game.Lighting.Sky.SkyboxFt = "rbxasset://../../../shareddata/assets/1013850"
		game.Lighting.Sky.SkyboxLf = "rbxasset://../../../shareddata/assets/1013851"
		game.Lighting.Sky.SkyboxRt = "rbxasset://../../../shareddata/assets/1013849"
		game.Lighting.Sky.SkyboxUp = "rbxasset://../../../shareddata/assets/1013854"
		local g = game.Workspace:GetChildren()
		for i = 1,#g do
			if g[i].Name == "Tree" then
				g[i].Part.BrickColor = script.Winter.Value
			elseif g[i].Name == "Baseo" then
				g[i].BrickColor = script.Winter.Value
				g[i].Texture.Face = "Front"
			elseif g[i].Name == "Roofy" then
				g[i].Transparency = 0
			end
		end


	elseif script.Season.Value == 4 then -- Spring
		script.Season.Value = 1
		game.Lighting.Sky.SkyboxBk = "rbxasset://../../../shareddata/assets/2326662"
		game.Lighting.Sky.SkyboxDn = "rbxasset://../../../shareddata/assets/2326681"
		game.Lighting.Sky.SkyboxFt = "rbxasset://../../../shareddata/assets/2326652"
		game.Lighting.Sky.SkyboxLf = "rbxasset://../../../shareddata/assets/2326666"
		game.Lighting.Sky.SkyboxRt = "rbxasset://../../../shareddata/assets/2326670"
		game.Lighting.Sky.SkyboxUp = "rbxasset://../../../shareddata/assets/2326677"
		local g = game.Workspace:GetChildren()
		for i = 1,#g do
			if g[i].Name == "Tree" then
				g[i].Part.BrickColor = script.Spring.Value
			elseif g[i].Name == "Baseo" then
				g[i].BrickColor = script.Spring.Value
			elseif g[i].Name == "Roofy" then
				g[i].Transparency = 1
			end
		end
	end



while true do
	wait(600)
	game.Lighting.Ambient = Color3.new(1,0.7,0.4) -- aternoon
	game.Lighting.TimeOfDay = "17:50:00"
	wait(120)
	game.Lighting.Ambient = Color3.new(0.5,0.5,0.5) -- night
	game.Lighting.TimeOfDay = "20:00:00"
	wait(300)
	game.Lighting.Ambient = Color3.new(1,1,0.5) --morning
	game.Lighting.TimeOfDay = "06:20:00"
	wait(120)
	game.Lighting.Ambient = Color3.new(1,1,1) -- 
	game.Lighting.TimeOfDay = "12:00:00"
	wait(600)
	game.Lighting.Ambient = Color3.new(1,0.7,0.4)
	game.Lighting.TimeOfDay = "17:50:00"
	wait(120)
	game.Lighting.Ambient = Color3.new(0.5,0.5,0.5)
	game.Lighting.TimeOfDay = "20:00:00"
	wait(300)
	game.Lighting.Ambient = Color3.new(1,1,0.5)
	game.Lighting.TimeOfDay = "06:20:00"
	wait(120)
	game.Lighting.Ambient = Color3.new(1,1,1)
	game.Lighting.TimeOfDay = "12:00:00"
	if script.Season.Value == 1 then -- Summer
		script.Season.Value = 2
		game.Lighting.Sky.SkyboxBk = "rbxasset://../../../shareddata/assets/2326662"
		game.Lighting.Sky.SkyboxDn = "rbxasset://../../../shareddata/assets/2326681"
		game.Lighting.Sky.SkyboxFt = "rbxasset://../../../shareddata/assets/2326652"
		game.Lighting.Sky.SkyboxLf = "rbxasset://../../../shareddata/assets/2326666"
		game.Lighting.Sky.SkyboxRt = "rbxasset://../../../shareddata/assets/2326670"
		game.Lighting.Sky.SkyboxUp = "rbxasset://../../../shareddata/assets/2326677"
		local g = game.Workspace:GetChildren()
		for i = 1,#g do
			if g[i].Name == "Tree" then
				g[i].Part.BrickColor = script.Summer.Value
			elseif g[i].Name == "Baseo" then
				g[i].BrickColor = script.Summer.Value
			end
		end



	elseif script.Season.Value == 2 then -- Fall
		script.Season.Value = 3
		game.Lighting.Sky.SkyboxBk = "rbxasset://../../../shareddata/assets/1014350"
		game.Lighting.Sky.SkyboxDn = "rbxasset://../../../shareddata/assets/1014351"
		game.Lighting.Sky.SkyboxFt = "rbxasset://../../../shareddata/assets/1014348"
		game.Lighting.Sky.SkyboxLf = "rbxasset://../../../shareddata/assets/1014349"
		game.Lighting.Sky.SkyboxRt = "rbxasset://../../../shareddata/assets/1014347"
		game.Lighting.Sky.SkyboxUp = "rbxasset://../../../shareddata/assets/2326677"
		local g = game.Workspace:GetChildren()
		for i = 1,#g do
			if g[i].Name == "Tree" then
				g[i].Part.BrickColor = script.Fall.Value
			elseif g[i].Name == "Baseo" then
				g[i].BrickColor = script.Fall.Value
				g[i].Texture.Face = "Top"
			end
		end


	elseif script.Season.Value == 3 then -- Winter
		script.Season.Value = 4
		game.Lighting.Sky.SkyboxBk = "rbxasset://../../../shareddata/assets/1013852"
		game.Lighting.Sky.SkyboxDn = "rbxasset://../../../shareddata/assets/1013853"
		game.Lighting.Sky.SkyboxFt = "rbxasset://../../../shareddata/assets/1013850"
		game.Lighting.Sky.SkyboxLf = "rbxasset://../../../shareddata/assets/1013851"
		game.Lighting.Sky.SkyboxRt = "rbxasset://../../../shareddata/assets/1013849"
		game.Lighting.Sky.SkyboxUp = "rbxasset://../../../shareddata/assets/1013854"
		local g = game.Workspace:GetChildren()
		for i = 1,#g do
			if g[i].Name == "Tree" then
				g[i].Part.BrickColor = script.Winter.Value
			elseif g[i].Name == "Baseo" then
				g[i].BrickColor = script.Winter.Value
				g[i].Texture.Face = "Front"
			elseif g[i].Name == "Roofy" then
				g[i].Transparency = 0
			end
		end


	elseif script.Season.Value == 4 then -- Spring
		script.Season.Value = 1
		game.Lighting.Sky.SkyboxBk = "rbxasset://../../../shareddata/assets/2326662"
		game.Lighting.Sky.SkyboxDn = "rbxasset://../../../shareddata/assets/2326681"
		game.Lighting.Sky.SkyboxFt = "rbxasset://../../../shareddata/assets/2326652"
		game.Lighting.Sky.SkyboxLf = "rbxasset://../../../shareddata/assets/2326666"
		game.Lighting.Sky.SkyboxRt = "rbxasset://../../../shareddata/assets/2326670"
		game.Lighting.Sky.SkyboxUp = "rbxasset://../../../shareddata/assets/2326677"
		local g = game.Workspace:GetChildren()
		for i = 1,#g do
			if g[i].Name == "Tree" then
				g[i].Part.BrickColor = script.Spring.Value
			elseif g[i].Name == "Baseo" then
				g[i].BrickColor = script.Spring.Value
			elseif g[i].Name == "Roofy" then
				g[i].Transparency = 1
			end
		end
	end
end

