            <Properties>
              <bool name="Disabled">false</bool>
              <Content name="LinkedSource">
                <null></null>
              </Content>
              <string name="Name">Script</string>
              <ProtectedString name="Source">local isOn = true

function on()
	isOn = true
	script.Parent.Bulb.Transparency = .5

end

function off()
	isOn = false
	script.Parent.Bulb.Transparency = 1
end

function onClicked()
	
	if isOn == true then off() else on() end

end

script.Parent.Stand.ClickDetector.MouseClick:connect(onClicked)

on()</ProtectedString>
