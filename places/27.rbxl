              <null></null>
            </Content>
            <string name="Name">LocalScript</string>
            <ProtectedString name="Source">a=false
cam=nil
mode = 1
q = nil
on = false

function onButton1Down(mouse)
if on == true then
if mode == 1 then
q.Text = "Your job is to put pizzas in boxes so the delivery boy can deliver the pizzas       Click to continue"
mode = 2
elseif mode == 2 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Hole
q.Text = "When the cooks are finish making a pizza or drink they will fall throught here"
mode = 3
elseif mode == 3 then
q.Text = "Use your hand tool to move the pizza or mountain dew"
mode = 4
elseif mode == 4 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.EmptyBox
q.Text = "Drag and drop a pizza on top of one of these boxes to put the pizzas in the box"
mode = 5
elseif mode == 5 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Sign
q.Text = "When this logo is on the box, that means that there is a pizza inside"
mode = 6
elseif mode == 6 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Belt
q.Text = "Now move the box withthe logo in it to on to this belt"
mode = 7
elseif mode == 7 then
q.Text = "If you get a mountain dew, you can't box is so just put it on this belt"
mode = 8
elseif mode == 8 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Bin.Top
q.Text = "If a pizza will not go in a box, move the pizza on top of this trash can to remove it"
mode = 9
elseif mode == 9 then
q:remove()
mode = 1
game.Workspace.CurrentCamera.CameraSubject=game.Players.LocalPlayer.Character
game.Workspace.CurrentCamera:Remove()
game.Workspace.CurrentCamera=cam
on = false
end
end
end 

function onSelected(mouse)

	mouse.Icon = "rbxasset://textures\\ArrowCursor.png"
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
cam=game.Workspace.CurrentCamera:clone()
cam.Parent=game.Workspace
game.Workspace.CurrentCamera.CameraType=4

q = Instance.new("Hint")
q.Text = "Click to continue"
q.Parent = script.Parent.Parent.Parent
on = true

end

script.Parent.Selected:connect(onSelected)

function yo()
if on == true then
on = false
q:remove()
game.Workspace.CurrentCamera.CameraSubject=game.Players.LocalPlayer.Character
game.Workspace.CurrentCamera:Remove()
game.Workspace.CurrentCamera=cam
end
end
