function onActivated(mouse)
	if a == false then
		a = true
		script.Parent.Handle.De:remove()
	local g = script.Parent:GetChildren()
	for i = 1,#g do
		if g[i].className == "Decal" then
			g[i].Parent = script.Parent.Handle
		end
	end
	return
	end
	if script.Parent.Handle:FindFirstChild("Decal") ~= nil then
		script.Parent.Handle.Decal:remove()
	elseif script.Parent.Handle:FindFirstChild("Decal") == nil then
		script.Parent.Handle.CanCollide = false
	end
end


