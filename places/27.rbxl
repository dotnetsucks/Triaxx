raiseDe = false
homeDe = false
spawnDe = false






function onButton1Down(mouse)	
	if mouse.Target == nil then return end
		
	if mouse.Target.Parent:FindFirstChild("Humanoid") ~= nil and game.Players:GetPlayerFromCharacter(mouse.Target.Parent) ~= nil and option == false and s.TeamColor == BrickColor.new(28) then
		option = true
		targey = game.Players:GetPlayerFromCharacter(mouse.Target.Parent)
		return
	end
	if option == true and targey ~= nil then
		option = false
		if options == 1 and raiseDe == false then
			targey.leaderstats.Money.Value = targey.leaderstats.Money.Value + 30
			targey.Raise.Value = targey.Raise.Value + 1
			script.Parent.Parent.Parent.leaderstats.Money.Value = script.Parent.Parent.Parent.leaderstats.Money.Value - 5
			raiseDe = true
			wait(10)
			raiseDe = false
			return

		elseif options == 2 and targey.Raise.Value ~= 0 then
			targey.leaderstats.Money.Value = targey.leaderstats.Money.Value - 30
			targey.Raise.Value = targey.Raise.Value - 1
			s.leaderstats.Money.Value = s.leaderstats.Money.Value + 5
			return

		elseif options == 3 then
			game.Workspace.EOD.Value = targey
			return

		elseif options == 4 and homeDe == false then
			local g = game.Workspace:GetChildren()
			for i = 1,#g do
				if g[i].Name == "House" and g[i].Owner.Value == targey then
					targey.Character:MoveTo(g[i].Spawn.Position)
				end
			end
			homeDe = true	
			wait(60)
			homeDe = false
			return
		elseif options == 5 and spawnDe == false then
			local g = game.Workspace:GetChildren()
			for i = 1,#g do
				if g[i].className == "SpawnLocation" then
					if g[i].BrickColor == targey.TeamColor then
						targey.Character:MoveTo(g[i].Position)
					end
				end
			end
			spawnDe = true
			wait(30)
			spawnDe = false
			return
		end
	end



------------------------------------------------------------------------------

	if s.TeamColor == BrickColor.new(21) then
		register(mouse.Target)
		phone(mouse.Target)
		
	end
	if s.TeamColor == BrickColor.new(24) then
		cook(mouse)
	end
	
	if mouse.Target.Name == "MountainDew" or mouse.Target.Name == "FullBox" then
		if s.TeamColor == BrickColor.new(23) then
			deliver(mouse)
		end
	end
	
	if mouse.Target.Parent.Name == "Telephone" then
		order(mouse)
	end


	--[[if mouse.Target.Locked == false then
		if mouse.Target.Name == "MountainDew" and s.TeamColor == BrickColor.new(106) or
			mouse.Target.Name == "FullBox" and s.TeamColor == BrickColor.new(106) or
			mouse.Target.Name == "EmptyBox" and s.TeamColor == BrickColor.new(106) or
			mouse.Target.Name == "Pizza" and s.TeamColor == BrickColor.new(106) or
			mouse.Target.Name == "Dew" and s.TeamColor == BrickColor.new(24) or
			mouse.Target.Name == "Dough" and s.TeamColor == BrickColor.new(24) or
			mouse.Target:FindFirstChild("Refill") ~= nil and s.TeamColor == BrickColor.new(1) then
			
			selected = mouse.Target
			selected.Parent = bin.Parent.Parent.Character
			mouse.Icon = "rbxasset://textures\\GrabCursor.png"
			--anc = selected.Anchored
			selected.Anchored = true
			if mouse.Target:FindFirstChild("Owner") ~= nil then
				mouse.Target.Owner.Value = s
			end
		end
	end]]
end












