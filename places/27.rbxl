            <string name="Name">Script</string>
            <ProtectedString name="Source">s = script.Parent.Parent.Parent.Parent

function yo()
	if s.Voter.Value ~= nil then
		s.Voter.Value.Vote.Value = s.Voter.Value.Vote.Value  - 1
	end

	if game.Players:FindFirstChild(script.Parent.Text) ~= nil then
		s.Voter.Value = game.Players:FindFirstChild(script.Parent.Text)
		s.Voter.Value.Vote.Value = s.Voter.Value.Vote.Value  + 1
	end

	local g = script.Parent.Parent:GetChildren()
	for i = 1,#g do
		if g[i].className == "TextButton" and g[i].Name ~= "Home" and g[i].Name ~= "Reset" and g[i].Name ~= "Vote" then
			g[i]:remove()
		end
	end
end
