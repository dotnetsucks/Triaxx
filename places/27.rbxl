            <string name="Name">LocalScript</string>
            <ProtectedString name="Source">a=false
cam=nil
mode = 1
q = nil
on = false

function onButton1Down(mouse)
if on == true then
if mode == 1 then
q.Text = "Your job as a cashier is to take orders from customers in the store and customers calling in      Click to continue"
mode = 2
elseif mode == 2 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Customer.Torso
q.Text = "This is a customer. To take their order you must select your cashier tool and click them"
mode = 3
elseif mode == 3 then
q.Text = "Then the customer will tell they what"
mode = 4
elseif mode == 4 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Register.Screen 
q.Text = "Use your action tool and click on the picture on this register that matches what the customer order"
mode = 5
elseif mode == 5 then
q.Text = "Example: the customer orders a pepperoni pizza. You would then find the picture of a pepperoni pizza and click on it with your cashier tool"
mode = 6
elseif mode == 6 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Phone.Handle
q.Text = "If you hear a telephone ring and a phone like this is flashing, that means that you need to awnser it."
mode = 7
elseif mode == 7 then
q.Text = "To do this, all you have to do is click with your cashier tool on phone and the person calling will tell you what they want to order."
mode = 8
elseif mode == 8 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Register.Screen 
q.Text = "Now just click on the picture on the register that matches what the customer wants and thats it!!!"
mode = 9
elseif mode == 9 then
q:remove()
mode = 1
game.Workspace.CurrentCamera.CameraSubject=game.Players.LocalPlayer.Character
game.Workspace.CurrentCamera:Remove()
game.Workspace.CurrentCamera=cam
on = false
end 
end
end

function onSelected(mouse)

	mouse.Icon = "rbxasset://textures\\ArrowCursor.png"
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
cam=game.Workspace.CurrentCamera:clone()
cam.Parent=game.Workspace
game.Workspace.CurrentCamera.CameraType=4

q = Instance.new("Hint")
q.Text = "Click to continue"
q.Parent = script.Parent.Parent.Parent
on = true

end

script.Parent.Selected:connect(onSelected)

function yo()
if on == true then
on = false
q:remove()
game.Workspace.CurrentCamera.CameraSubject=game.Players.LocalPlayer.Character
game.Workspace.CurrentCamera:Remove()
game.Workspace.CurrentCamera=cam
end
end
