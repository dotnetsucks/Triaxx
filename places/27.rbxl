              <null></null>
            </Content>
            <string name="Name">LocalScript</string>
            <ProtectedString name="Source">a=false
cam=nil
mode = 1
q = nil
on = false

function onButton1Down(mouse)
if on == true then
if mode == 1 then
q.Text = "Your job is to make pizzas      Click to continue"
mode = 2
elseif mode == 2 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Orders.a5
q.Text = "This order board shows all the orders that need to be made"
mode = 3
elseif mode == 3 then
q.Text = "If there is a picture of a pepperoni pizza, that means you must make one"
mode = 4
elseif mode == 4 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Dough
q.Text = "Starting out you need to get some dough that looks like this"
mode = 5
elseif mode == 5 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.TomatoSauce1
q.Text = "Then select your cook tool, click on this tomato sauce, and click on your pizza dough"
mode = 6
elseif mode == 6 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Cheese1
q.Text = "You must do the same thing for the cheese as you do the tomato sauce"
mode = 7
elseif mode == 7 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Pepperoni1
q.Text = "Then add pepperoni to it"
mode = 8
elseif mode == 8 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Belty
q.Text = "Then place the pizza on this belt to go in the oven "
mode = 9
elseif mode == 9 then
q.Text = "You are now done making the pizza "
mode = 10
elseif mode == 10 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Belter
q.Text = "If there is a mountain dew on the order board then just place one on the belt"
mode = 11
elseif mode == 11 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.TomatoSauce
q.Text = "This will tell you how much tomato sauce is in supply"
mode = 12
elseif mode == 12 then
q.Text = "If this reaches 0 then you will not be able to use tomato sauce"
mode = 13
elseif mode == 13 then
q:remove()
mode = 1
game.Workspace.CurrentCamera.CameraSubject=game.Players.LocalPlayer.Character
game.Workspace.CurrentCamera:Remove()
game.Workspace.CurrentCamera=cam
on = false
end
end
end


function onSelected(mouse)

	mouse.Icon = "rbxasset://textures\\ArrowCursor.png"
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
cam=game.Workspace.CurrentCamera:clone()
cam.Parent=game.Workspace
game.Workspace.CurrentCamera.CameraType=4

q = Instance.new("Hint")
q.Text = "Click to continue"
q.Parent = script.Parent.Parent.Parent
on = true

end

script.Parent.Selected:connect(onSelected)

function yo()
if on == true then
on = false
q:remove()
game.Workspace.CurrentCamera.CameraSubject=game.Players.LocalPlayer.Character
game.Workspace.CurrentCamera:Remove()
game.Workspace.CurrentCamera=cam
end
end
