          <string name="Name">Script</string>
          <ProtectedString name="Source">function check()
local p = 0
local f = game.Workspace:GetChildren()
for i = 1,#f do
if f[i].Name == "Dew" then
p = p + 1
end
end 
return p
end

while true do
wait(2)
if check() &lt; 15 then
if game.Workspace.Items.MountainDew.Value ~= 0 then
game.Workspace.Items.MountainDew.Value = game.Workspace.Items.MountainDew.Value - 1
local p = game.Lighting.Storage.Dew:clone()
p.Parent = game.Workspace
p.Position = script.Parent.Position
p.RotVelocity = Vector3.new(math.random(-5,5), math.random(-5,5), math.random(-5,5))
end
end 
end </ProtectedString>
