					game:GetService("BadgeService"):UserHasBadge(r[i].userId, 14678224) == false then
					r[i].TeamColor = BrickColor.new(21)
					r[i].Character:MoveTo(game.Workspace.TheSpawns.spawno.Position)
				end
			end
		end
		return a
	end
end

