bin=script.Parent
ee = nil

local sr = script.Parent[""]:clone()
sr.Parent = game.Workspace
sr.Name = bin.Parent.Parent.Name .. "storage"

function dis(s)
local g = s.Character:GetChildren()
for i = 1,#g do
if g[i].className == "Part" then
g[i].Transparency = 1
end
end
end

function ss(s)
local rr = sr:GetChildren()
for i = 1,#rr do
rr[i]:remove()
end
local g = s.Character:GetChildren()
for i = 1,#g do
if g[i].className ~= "Part" and g[i].className ~= "Humanoid" then
g[i].Parent = sr
end
end
local d =s.Character.Head:FindFirstChild("face")
if d ~= nil then
--d.Parent = sr
d:remove()
end
end


function parts(s)
ee =  Instance.new("Model")
ee.Parent = game.Workspace
ee.Name = s.Name

local g = s.Character:GetChildren()
for i = 1,#g do
if g[i].className == "Part" or g[i].className == "Humanoid" then
g[i]:clone().Parent = ee
end
end
end


function get(s)
local g = sr:GetChildren()
for i = 1,#g do
g[i].Parent = s.Character
end
local e = s.Character:GetChildren()
for i = 1,#e do
if e[i].className == "Part" then
e[i].Transparency = 0
end
end
--sr.face.Parent = s.Character.Head
end



