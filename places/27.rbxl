              <null></null>
            </Content>
            <string name="Name">LocalScript</string>
            <ProtectedString name="Source">a=false
cam=nil
mode = 1
q = nil
on = false

function onButton1Down(mouse)
if on == true then
if mode == 1 then
q.Text = "Your job is to deliver pizzas to houses    Click to continue"
mode = 2
elseif mode == 2 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Pady.Tile
q.Text = "This is where pizzas will come from"
mode = 3
elseif mode == 3 then
q.Text = "If there are pizzas or drinks there, use your deliver tool and move your cursor over the pizza/drink to pick it up"
mode = 4
elseif mode == 4 then
q.Text = "You will then get a bunch of tool in your backback"
mode = 5
elseif mode == 5 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Torso
q.Text = "You must take the pizza to the house that the tool is called"
mode = 6
elseif mode == 6 then
q.Text = "Example: The tool says To: c1 that means that you must take that pizza to house c1"
mode = 7
elseif mode == 7 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Tiles.Guy:FindFirstChild("").Head
q.Text = "When you get to the house, get out the pizza/drink and give it to the person standing on the front porch like this one"
mode = 8
elseif mode == 8 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Car.Roof
q.Text = "You dont have to walk to all the houses if you dont want to. You can take a car!"
mode = 9
elseif mode == 9 then
q.Text = "Just get in the car, and press the arrow keys to go"
mode = 10
elseif mode == 10 then
q:remove()
mode = 1
game.Workspace.CurrentCamera.CameraSubject=game.Players.LocalPlayer.Character
game.Workspace.CurrentCamera:Remove()
game.Workspace.CurrentCamera=cam
on = false
end 
end
end
function onSelected(mouse)

	mouse.Icon = "rbxasset://textures\\ArrowCursor.png"
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
cam=game.Workspace.CurrentCamera:clone()
cam.Parent=game.Workspace
game.Workspace.CurrentCamera.CameraType=4

q = Instance.new("Hint")
q.Text = "Click to continue"
q.Parent = script.Parent.Parent.Parent
on = true

end

script.Parent.Selected:connect(onSelected)

function yo()
if on == true then
on = false
q:remove()
game.Workspace.CurrentCamera.CameraSubject=game.Players.LocalPlayer.Character
game.Workspace.CurrentCamera:Remove()
game.Workspace.CurrentCamera=cam
end
end
script.Parent.Deselected:connect(yo)</ProtectedString>
