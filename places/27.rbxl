--[[function onMove(mouse)
print("HI")
if mouse.Target.Name == "Sausage" or mouse.Target.Name == "Cheese" or mouse.Target.Name == "MountainDew" or mouse.Target.Name == "Pepperoni" and mouse.Target.Parent.Name == "Register" then
gt.Parent = mouse.Target
elseif mouse.Target.Parent:FindFirstChild("Order") ~= nil or mouse.Target.Parent.Name == "Phone" then
gt.Parent = mouse.Target.Parent
else
gt.Parent = nil
end
end]]

function find()
local g = game.Workspace.Customers:GetChildren()
return g[math.random(1,#g)]
end


function phone(mouseTarget)


if mouseTarget.Parent.Name == "Phone" and mouseTarget.Parent.Ringing.Value == true then
e = find()
mess = Instance.new("Hint")
mess.Text = r[e.Value]
mess.Parent = script.Parent.Parent.Parent
script.Parent.Person.Value = e
mode = 2


mouseTarget.Parent.Ringing.Value = false
end

if mouseTarget.Parent.Name == "Register" and mode == 2 and script.Parent.Person.Value ~= nil then
if mouseTarget.Value.Value == e.Value then

local gy = mouseTarget:FindFirstChild(mouseTarget.Name)
if gy ~= nil then
tar = mouseTarget
script.Parent.Ding:Play()
local f = Instance.new("Decal")
f.Texture = gy.Texture
f.Name = gy.Name
f.Face = "Front"
f.Parent = game.Workspace.Orders.Storage

script.Parent.Parent.Parent.Cashier.Value = script.Parent.Parent.Parent.Cashier.Value + 1

local h = Instance.new("StringValue")
h.Value = house[math.random(1,#house)]
h.Name = "House"
h.Parent = f


mess.Parent = nil
script.Parent.Person.Value = nil
tar.BrickColor = BrickColor.new(21)
wait()
tar.BrickColor = BrickColor.new(194)

end
end
end
end














function register(mouseTarget)
print("1")
if mouseTarget == nil then  return end

local r = mouseTarget.Parent:FindFirstChild("Say")
if r ~= nil then

r.Parent.Name = r.Value
script.Parent.Person.Value = mouseTarget.Parent
mode = 1
end



if mouseTarget.Parent.Name == "Register" and mode == 1 then
if script.Parent.Person.Value ~= nil then
if mouseTarget.Value.Value == script.Parent.Person.Value.Order.Value then


local g = mouseTarget:FindFirstChild(mouseTarget.Name)
if g ~= nil then
tar = mouseTarget

script.Parent.Ding:Play()

local f = Instance.new("Decal")
f.Texture = g.Texture
f.Name = g.Name
f.Face = "Front"
f.Parent = game.Workspace.Orders.Storage
mode =  1

script.Parent.Parent.Parent.Cashier.Value = script.Parent.Parent.Parent.Cashier.Value + 1

local h = Instance.new("StringValue")
h.Value = script.Parent.Person.Value.House.Value
h.Name = "House"
h.Parent = f



local y = script.Parent.Person.Value.Lane.Value
if y == 1 then
game.Workspace.Lane1.OCC.Value = false
elseif y == 2 then
game.Workspace.Lane2.OCC.Value = false
end

script.Parent.Person.Value.Parent = nil
script.Parent.Person.Value = nil

tar.BrickColor = BrickColor.new(21)
wait()
tar.BrickColor = BrickColor.new(194)
end
end
end
end
end







 

function onButton1Down(mouse)
if mouse.Target == nil then return end
register(mouse.Target)
phone(mouse.Target)
end





