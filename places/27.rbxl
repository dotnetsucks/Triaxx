          <ProtectedString name="Source">tabs = {}

function check(yo)
local y = yo:GetChildren()
for i = 1,#y do
if y[i] ~= nil then
return y[i]
end
end
return nil
end


function place(tab)
local g = script.Parent:GetChildren()
for i = 1,#g do
if g[i].className == "Part" then
if g[i].Name ~= "border" then
if check(g[i]) == nil then

tab.Parent = g[i]
return
end
end
end
end
end


function allign(tab)
if tab.className == "Decal" then
place(tab)
end
end

script.Parent.Storage.ChildAdded:connect(allign)




