            <string name="Name">Fly</string>
            <ProtectedString name="Source">wait(0.5)
bin=script.Parent
plane=nil
hold=false
local debounce = false
local planedebounce = false
local stuntdebounce = false
local controlling = false
on = false
mode = 25

script.Parent.Parent.Parent.Character.Animate:remove()
local a = script.Animate:clone()
a.Disabled = false
a.Parent = script.Parent.Parent.Parent.Character

pp = Instance.new("Part")
pp.Size = Vector3.new(0,0,0)
pp.Name = "Block"
pp.Transparency = 1
pp.Parent = script.Parent.Parent.Parent.Character

ww = Instance.new("Weld")
ww.Part0 = script.Parent.Parent.Parent.Character.Torso
ww.Part1 = pp
ww.C0 = CFrame.fromEulerAnglesXYZ(1.6,0,0)
ww.Parent = ww.Part0
dir = nil

gg = Instance.new("BodyGyro")
gg.maxTorque = Vector3.new(0,0,0)
gg.Parent = pp

vv = Instance.new("BodyVelocity")
vv.maxForce = Vector3.new(0,0,0)
vv.Parent = pp

--[[function cloud()
local c = script.Parent.Cloud:clone()
c.CanCollide = false
c.Parent = game.Workspace
c.Position = script.Parent.Parent.Parent.Character.Torso.Position
local s = Instance.new("Script")
s.Source = 
p = 0
while true do
wait(0.05)
p = p + 1
if p &lt; 5 then
local r = script.Parent.Mesh
r.Scale = Vector3.new(r.Scale.x+5, r.Scale.y+5, r.Scale.z+5)
elseif p &gt; 5 then
script.Parent:remove()
end
end
s.Parent = c
end
]]



--[[function fire()
	local missile = bin.Arrow:clone()
	missile.CFrame = script.Parent.Parent.Parent.Character.Torso.CFrame * CFrame.new(0, 0, -10)

	--missile.RocketScript.Disabled = false
	missile.Parent = game.Workspace

	local creator_tag = Instance.new("ObjectValue")
	creator_tag.Value = script.Parent.Parent.Parent
	creator_tag.Name = "creator"
	creator_tag.Parent = missile

end]]



--[[function wings(c)
local w = script.Parent.Wing:clone()
w.Parent = script.Parent.Parent.Parent.Character
local r = Instance.new("Weld") 
r.Part0 = script.Parent.Parent.Parent.Character.Torso
r.Part1 = w
r.C0 = c
r.Parent = r.Part0
end]]



function move(target, engine)
	local origincframe = engine:findFirstChild("BodyGyro").cframe
dir = (target - engine.Position).unit
	local spawnPos = engine.Position
script.Parent.Parent.Parent.Character.Humanoid.Sit = true
	local pos = spawnPos + (dir * 1)

vv.maxForce = Vector3.new(10000000000000,100000000000000,100000000000000)
vv.velocity = dir * mode

	engine:findFirstChild("BodyGyro").maxTorque = Vector3.new(9000, 9000, 9000)
	engine:findFirstChild("BodyGyro").cframe = CFrame.new(pos,  pos + dir)
	wait(0.1)
	engine:findFirstChild("BodyGyro").maxTorque = Vector3.new(0, 0, 0)
	engine:findFirstChild("BodyGyro").cframe = origincframe
end



function onButton1Down(mouse)
script.Parent.Parent.Parent.Character.Humanoid.WalkSpeed= 0
	local vehicle = script.Parent.Parent.Parent.Character
on = true
	if vehicle ~= nil and debounce == false and planedebounce == false then
	debounce = true

	controlling = true

	while true do
		wait()
		local engine = vehicle.Block
		local position = mouse.Hit
		local target = position.p
	if on == false then break end
--cloud()
		move(target, engine)
		if planedebounce == true or controlling == false then break end
	end
	wait(.1)
	debounce = false
	end
end

function onButton1Up(mouse)
script.Parent.Parent.Parent.Character.Humanoid.WalkSpeed = 16
	controlling = false
on = false
vv.maxForce = Vector3.new(0,0,0)
script.Parent.Parent.Parent.Character.Humanoid.Sit = false
end

function onSelected(mouse)
	mouse.Icon = "rbxasset://textures\\GunCursor.png"
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
	mouse.KeyDown:connect(onKeyDown)
end

function onKeyDown(key)
if key == "f" and mode == 25 then
mode = 100
elseif key == "f" and mode == 100 then
mode = 25
end
end
bin.Selected:connect(onSelected)
