            <ProtectedString name="Source">bin = script.Parent
function check(t)
local f = game.Workspace.TheSpawns:GetChildren()
for i = 1,#f do
if f[i].className == "SpawnLocation" then
if t.TeamColor == f[i].TeamColor then
if (f[i].Position - t.Character.Torso.Position).magnitude &gt; f[i].Dis.Value then
t.Character.Torso.CFrame = CFrame.new(Vector3.new(f[i].Position.x,f[i].Position.y+ 2,f[i].Position.z))
end
end
end
end
end

function onButton1Down(mouse)
if mouse.Target == nil then  return end
local h = mouse.Target.Parent:FindFirstChild("Humanoid")
if h ~= nil then
local a = game.Players:GetPlayerFromCharacter(h.Parent)
if a ~= nil then
check(a)
end
end
end



