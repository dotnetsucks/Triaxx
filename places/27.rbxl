          <string name="Name">Active</string>
          <ProtectedString name="Source">function home()
	if script.Parent.Parent.Parent.Character.Humanoid.Health == 0 then return end
	local g = game.Workspace:GetChildren()
	for i = 1,#g do
		if g[i].Name == "House" and g[i].Owner.Value == script.Parent.Parent.Parent then
			script.Parent.Parent.Parent.Character:MoveTo(g[i].Spawn.Position)
		end
	end
end

function reset()
	script.Parent.Parent.Parent.Character.Humanoid.Health = 0
end

function vote()
	local p = script.Parent:GetChildren()
	if #p &gt; 4 then return end
	local yo = 19
	local g = game.Players:GetChildren()
	for i = 1,#g do
		if g[i] ~= script.Parent.Parent.Parent then
			local t = script.Parent.Vote:clone()
			t.Text = g[i].Name
			t.Name = "Person"
			t.Position = UDim2.new(0,700,0,yo)
			t.Parent = script.Parent
			local y = script.Script:clone()
			y.Disabled = false
			y.Parent = t
			yo = yo + 19
		end
	end
end









