cost = 30
script.Parent.Parent.Name = "Buy a Telephone (used to order pizza)  for  $" .. cost


function findhouse(h)
	local e = game.Players:GetPlayerFromCharacter(h)
	if e ~= nil then
		local g = game.Workspace:GetChildren()
		for i = 1,#g do
			if g[i].Name == "House" and g[i].Owner.Value == e then
				return g[i]
			end
		end
	end
	return nil
end

de = false

function touch(hit)
	local h = hit.Parent:FindFirstChild("Humanoid")
	if h ~= nil and h.Health ~= 0 and de == false then
		if findhouse(h.Parent) ~= nil then
			local t = game.Players:GetPlayerFromCharacter(h.Parent)
			if t ~= nil and t:FindFirstChild("leaderstats") ~= nil and t.leaderstats.Money.Value &gt;= cost then
if t:FindFirstChild(item) == nil then return end
				t.leaderstats.Money.Value = t.leaderstats.Money.Value - cost
				local a = t:FindFirstChild(item).Value
				a.Parent = findhouse(h.Parent)
				a:MakeJoints()
				de = true
				script.Parent.Parent.Name = "Bought " .. item
				wait(2)
				de = false
				script.Parent.Parent.Name = "Buy a Telephone (used to order pizza)  for  $" .. cost
			end
		end
	end
end

script.Parent.Touched:connect(touch)

