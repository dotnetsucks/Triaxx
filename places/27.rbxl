on = false

function onButton1Down(mouse)
if on == true then
if mode == 1 then
q.Text = "Your job is to deliver supplies to the pizza shop       Click to continue"
mode = 2
elseif mode == 2 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Truck.VehicleSeat
q.Text = "First you will need to get one of these trucks"
mode = 3
elseif mode == 3 then
q.Text = "Just get in the truck, select your truck tool, and hold down your mouse to go"
mode = 4
elseif mode == 4 then
q.Text = "Now you need supplies to fill the truck up with"
mode = 5
elseif mode == 5 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Target
q.Text = "Move your truck right on top of this target"
mode = 6
elseif mode == 6 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Pepperonir
q.Text = "Get out of your truck and start pressing these buttons"
mode = 7
elseif mode == 7 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Boxyer
q.Text = "Boxes like this will start to fall into your truck"
mode = 8
elseif mode == 8 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Here
q.Text = "Once you are done filling up, drive your truck over here"
mode = 9
elseif mode == 9 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Bel
q.Text = "Grab the boxes from your truck and put them on this convayer belt and thats all!"
mode =10
elseif mode == 10 then
q:remove()
mode = 1
game.Workspace.CurrentCamera.CameraSubject=game.Players.LocalPlayer.Character
game.Workspace.CurrentCamera:Remove()
game.Workspace.CurrentCamera=cam
end
end
end



