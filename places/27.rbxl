function onButton1Down(mouse)
if mouse.Target == nil then return end
local y = mouse.Target:FindFirstChild("Cost")
if y ~= nil then
local t = script.Parent.Parent.Parent:FindFirstChild("leaderstats")
if t ~= nil and t.Money.Value &gt;= y.Value then
t.Money.Value = t.Money.Value - y.Value
game.Lighting.Tools:FindFirstChild(mouse.Target.Name):clone().Parent = t.Parent.Backpack
end
end
local r = mouse.Target.Parent:FindFirstChild("Pos")
if r ~= nil then
print("1")
local e = mouse.Target.Parent:FindFirstChild("Owner")
if e ~= nil and e.Value == script.Parent.Parent.Parent.Name then
print("2")
game.Lighting.Tools:FindFirstChild(mouse.Target.Parent.Name):clone().Parent = script.Parent.Parent.Parent.Backpack
mouse.Target.Parent:remove()
end
end
end


