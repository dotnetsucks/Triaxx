function onMove(mouse)
if mouse.Target == nil then return end
local e = mouse.Target.Name
print(1)
if e == "Dew" or e == "EmptyBox" or e == "Dough" or e == "FullBox" or e == "Boxesr" or e == "Cheeser" or e == "Doughr" or e == "MountainDewr" or e == "Pepperonir" or e == "Sausager" or e == "TomatoSaucer" then
print(2)
mouse.Target.Velocity = Vector3.new(mouse.Target.Velocity.x, mouse.Target.Velocity.y + 0.005, mouse.Target.Velocity.z)
end
end                                            

function onSelected(mouse)


        mouse.Icon = "rbxasset://textures\\GunCursor.png"

   mouse.Move:connect(function() onMove(mouse) end)

