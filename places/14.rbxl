function hit()
	print(&quot;hitting&quot;)
	local anim = Instance.new(&quot;StringValue&quot;)
	anim.Name = &quot;toolanim&quot;
	anim.Value = &quot;Slash&quot;
	anim.Parent = Tool
end

function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;

	wait(0.5)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	enabled = true

end

function onActivated() 
	if not Tool.Enabled then
		return
	end
	
	Tool.Enabled = false
	hit()
	Tool.Enabled = true

end 

function moneycheck(hit)
	nick = Tool.Parent.Name
	user = game.Players:findFirstChild(nick)
	Money = user.leaderstats.Money
	
	if hit.Name == &quot;Mountain&quot; then
		Money.Value = Money.Value + 1
	end
	
	if hit.Name == &quot;Copper&quot; then
		Money.Value = Money.Value + 5
	end
	
	if hit.Name == &quot;Silver&quot; then
		Money.Value = Money.Value + 15
	end

	if hit.Name == &quot;Gold&quot; then
		Money.Value = Money.Value + 45
	end

	if hit.Name == &quot;Platinum&quot; then
		Money.Value = Money.Value + 100
	end

	if hit.Name == &quot;Ruby&quot; then
		Money.Value = Money.Value + 250
	end

	if hit.Name == &quot;Mega-Jewel&quot; then
		Money.Value = Money.Value + 1500
	end
	
	if hit.Name == &quot;Adamantium&quot; then
		count.Value = count.Value + 1
		Money.Value = Money.Value + 1500
	end

	if hit.Name == &quot;Gaspocket&quot; then
		Money.Value = Money.Value * 0.9
		Tool.Parent.Humanoid.Health = Tool.Parent.Humanoid.Health - 100
	end

	local message = Instance.new(&quot;Message&quot;) 
	message.Text = &quot;Mined &quot; .. hit.Name
	message.Parent = user
	hit:remove()
	wait(0.7)
	message:remove()
end

function onTouched(hitt)
--	print(&quot;touched something&quot;)
	if ting == 0 then
	ting = 1
	if hitt.Parent.Name == &quot;Mountainlvl&quot; then
		lvl = game.Players:findFirstChild(Tool.Parent.Name)
		dig = (lvl.pickaxelvl.Value / 20)
		hitt.Transparency = hitt.Transparency + dig
		if hitt.Transparency &gt; 0.95 then
			moneycheck(hitt)
		end
		wait(0.5)
	end
	ting = 0
	end
end

Tool.Activated:connect(onActivated)
connection = Tool.Handle.Touched:connect(onTouched)
