			<Item class="Script" referent="RBX7601">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<string name="Source">Tool = script.Parent

function onActivated() 
	if not Tool.Enabled then
		return
	end
	
	Tool.Enabled = false
	local hit = Tool.Target.Value


	if hit ~= nil then 
		if hit.Parent.Name == &quot;Mountainlvl&quot; then 
			local nick = Tool.Parent.Name
			local user = game.Players:findFirstChild(nick)
			local message = Instance.new(&quot;Message&quot;) 
			message.Text = &quot;This is &quot; .. hit.Name
			message.Parent = user
			wait(1)
			message:remove()
		end 
	end

	Tool.Enabled = true

end 

Tool.Activated:connect(onActivated)
