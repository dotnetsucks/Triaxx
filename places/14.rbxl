				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="Source">mountainclone = script.Parent.Mountain:clone()
wait(1)
count = game.Workspace.adam

while true do
if count.Value &gt; 130 then
count.Value = 0
local message = Instance.new(&quot;Message&quot;) 
message.Text = &quot;Your greed has made the gods angry..! They Shake the world and refill its contents!&quot;
message.Parent = game.Workspace 
wait(3)
message:remove()
game.Workspace.Mountain:remove()
newmountain = mountainclone:clone()
newmountain.Parent = game.Workspace
c = script.Parent.Mountain:getChildren()

for i = 1, #c do
	if c[i].Name == &quot;Mountainlvl&quot; then
		depth = c[i].lvl.Value
		d = c[i]:getChildren()
		copper = 0
		silver = 0
		gold = 0
		plati = 0
		ruby = 0
		super = 0
		bomb = 0
		adam = 0
		for j = 1, #d do
			if d[j].className == &quot;Part&quot; then
			check = math.random(1, (depth * 10))

			if check &lt; (depth * 2) then
				copper = copper +1
				d[j].Name = &quot;Copper&quot;
				d[j].BrickColor = BrickColor.new(105)
				d[j].Transparency = 0
				d[j].Reflectance = 0
			end

			if check &gt; 5 and check &lt; (depth * 2) then
				silver = silver + 1
				d[j].Name = &quot;Silver&quot;
				d[j].BrickColor = BrickColor.new(194)
				d[j].Reflectance = 0.1
				d[j].Transparency = 0
			end

			if check &gt; 15 and check &lt; (depth * 4) then
				gold = gold + 1
				d[j].Name = &quot;Gold&quot;
				d[j].BrickColor = BrickColor.new(24)
				d[j].Reflectance = 0.1
				d[j].Transparency = 0
			end

			if check &gt; 50 and check &lt; (depth * 5) then
				plati = plati + 1
				d[j].Name = &quot;Platinum&quot;
				d[j].BrickColor = BrickColor.new(11)
				d[j].Reflectance = 0.1
				d[j].Transparency = 0.2
			end

			if check &gt; 90 and check &lt; (depth * 7) then
				ruby = ruby + 1
				d[j].Name = &quot;Ruby&quot;
				d[j].BrickColor = BrickColor.new(21)
				d[j].Reflectance = 0.2
				d[j].Transparency = 0.1
			end

			if check &gt; 130 and check &lt; (depth * 10) then
				bomb = bomb + 1
				d[j].Name = &quot;Gaspocket&quot;
				d[j].BrickColor = BrickColor.new(21)
				d[j].Reflectance = 0
				d[j].Transparency = 0
			end

			if check &gt; 160 and check &lt; (depth * 10) then
				adam = adam + 1
				d[j].Name = &quot;Adamantium&quot;
				d[j].BrickColor = BrickColor.new(1)
				d[j].Transparency = 0
				d[j].Reflectance = 1
			end

			if depth &gt; 7 and check == 71 then
				super = super + 1
				d[j].Name = &quot;Mega-Jewel&quot;
				d[j].BrickColor = BrickColor.new(104)
				d[j].Reflectance = 0.3
				d[j].Transparency = 0.4
			end

			if check == 1 then
				d[j]:remove()
			end
			end
		end
--		print(&quot;LEVEL &quot; .. depth)
--		print(&quot;Copper - &quot; .. copper)
--		print(&quot;Silver - &quot; .. silver)
--		print(&quot;Gold - &quot; .. gold)
--		print(&quot;Platinum - &quot; .. plati)
--		print(&quot;Ruby - &quot; .. ruby)
--		print(&quot;Megajewels - &quot; .. super)
--		print(&quot;Adamantium - &quot; .. adam)
--		print(&quot;Bombs - &quot; .. bomb)
	end
end

end
wait(5)
end
