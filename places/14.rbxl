				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Leaderboard</string>
				<string name="Source">function onPlayerEntered(newPlayer)
	wait(.5)
	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;


	local cash = Instance.new(&quot;IntValue&quot;)
	
	cash.Name = &quot;Money&quot;
	cash.Value = 40 --This sets the amount of money every player starts with

	cash.Parent = stats
	
	stats.Parent = newPlayer

	local jetpacklvl = Instance.new(&quot;IntValue&quot;)
	jetpacklvl.Name = &quot;jetpacklvl&quot;
	jetpacklvl.Value = 1 --Keeps the level of the jetpack
	jetpacklvl.Parent = newPlayer

	local digdownlvl = Instance.new(&quot;IntValue&quot;)
	digdownlvl.Name = &quot;digdownlvl&quot;
	digdownlvl.Value = 1 -- keeps the level of the digdown-tool
	digdownlvl.Parent = newPlayer

	local pickaxelvl = Instance.new(&quot;IntValue&quot;)
	pickaxelvl.Name = &quot;pickaxelvl&quot;
	pickaxelvl.Value = 1 -- keeps the lvl of the pickaxe
	pickaxelvl.Parent = newPlayer
end

game.Players.ChildAdded:connect(onPlayerEntered)</string>
