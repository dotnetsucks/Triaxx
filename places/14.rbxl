				<Item class="Script" referent="RBX7521">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">local ting = 0 

function onTouched(hit)

	if ting == 0 then 
	ting = 1 
	check = hit.Parent:FindFirstChild(&quot;Humanoid&quot;) 

	if check ~= nil then 

		local user = game.Players:GetPlayerFromCharacter(hit.Parent) 
		local stats = user:findFirstChild(&quot;leaderstats&quot;) 

		if stats ~= nil then 
			local cash = stats:findFirstChild(&quot;Money&quot;)
			grade = user.jetpacklvl
			cost = 40 * (grade.Value * grade.Value)
			if cash.Value &gt; cost -1 then
			cash.Value  = cash.Value -cost
			grade.Value = grade.Value +1
			message = Instance.new(&quot;Message&quot;)
			message.Text = &quot;New Jetpacklvl: &quot; .. grade.Value
			message.Parent = user
			wait(2)
			message.Text = &quot;Jetpack upgraded successfully&quot;
			wait(1)
			message:remove()
			end
		end

	end

	ting = 0 
	end

end

